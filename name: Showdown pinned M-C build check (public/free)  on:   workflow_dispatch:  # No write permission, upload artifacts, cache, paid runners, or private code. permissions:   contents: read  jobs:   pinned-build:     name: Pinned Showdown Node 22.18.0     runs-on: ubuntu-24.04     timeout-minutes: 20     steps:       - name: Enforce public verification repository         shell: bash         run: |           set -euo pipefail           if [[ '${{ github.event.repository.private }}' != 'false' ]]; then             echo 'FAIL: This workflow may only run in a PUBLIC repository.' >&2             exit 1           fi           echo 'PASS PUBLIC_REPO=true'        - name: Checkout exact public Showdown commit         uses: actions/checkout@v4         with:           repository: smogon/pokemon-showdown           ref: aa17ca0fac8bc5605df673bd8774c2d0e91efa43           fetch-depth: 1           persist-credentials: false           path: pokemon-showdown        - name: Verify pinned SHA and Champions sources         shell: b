
name: Showdown pinned M-C build check (public/free)

on:
  workflow_dispatch:

# No write permission, upload artifacts, cache, paid runners, or private code.
permissions:
  contents: read

jobs:
  pinned-build:
    name: Pinned Showdown Node 22.18.0
    runs-on: ubuntu-24.04
    timeout-minutes: 20
    steps:
      - name: Enforce public verification repository
        shell: bash
        run: |
          set -euo pipefail
          if [[ '${{ github.event.repository.private }}' != 'false' ]]; then
            echo 'FAIL: This workflow may only run in a PUBLIC repository.' >&2
            exit 1
          fi
          echo 'PASS PUBLIC_REPO=true'

      - name: Checkout exact public Showdown commit
        uses: actions/checkout@v4
        with:
          repository: smogon/pokemon-showdown
          ref: aa17ca0fac8bc5605df673bd8774c2d0e91efa43
          fetch-depth: 1
          persist-credentials: false
          path: pokemon-showdown

      - name: Verify pinned SHA and Champions sources
        shell: bash
        working-directory: pokemon-showdown
        run: |
          set -euo pipefail
          expected='aa17ca0fac8bc5605df673bd8774c2d0e91efa43'
          actual="$(git rev-parse HEAD)"
          test "$actual" = "$expected" || { echo "FAIL_COMMIT expected=$expected actual=$actual"; exit 1; }
          test -f data/mods/champions/scripts.ts
          test -f data/mods/champions/rulesets.ts
          test -f config/formats.ts
          test -f package-lock.json
          echo "PASS PINNED_COMMIT=$actual"
          echo "SOURCE_TREE=$(git rev-parse HEAD^{tree})"
          test "$(git rev-parse HEAD^{tree})" = '98c9038b81fa5ed7f1e9818736b701918920501e'
          echo 'PASS PINNED_TREE=true'

      - name: Setup Node.js 22.18.0 (no cache)
        uses: actions/setup-node@v4
        with:
          node-version: '22.18.0'

      - name: Verify exact Node version
        shell: bash
        run: |
          set -euo pipefail
          test "$(node --version)" = 'v22.18.0'
          echo "PASS NODE=$(node --version)"
          echo "NPM=$(npm --version)"

      - name: npm ci (no audit, no cache upload)
        shell: bash
        working-directory: pokemon-showdown
        run: |
          set -euo pipefail
          npm ci --no-audit --no-fund
          echo 'PASS NPM_CI=true'

      - name: npm run build
        shell: bash
        working-directory: pokemon-showdown
        run: |
          set -euo pipefail
          npm run build
          echo 'PASS NPM_BUILD=true'

      - name: Load Champions Mod and M-C Singles format
        shell: bash
        working-directory: pokemon-showdown
        run: |
          set -euo pipefail
          node <<'NODE'
          const assert = require('node:assert/strict');
          const fs = require('node:fs');
          const { Dex } = require('./dist/sim');
          assert.ok(Dex, 'dist/sim must export Dex');
          assert.ok(fs.existsSync('data/mods/champions/scripts.ts'), 'Champions source must exist');
          const formatName = '[Gen 9 Champions] BSS Reg M-C';
          const format = Dex.formats.get(formatName);
          assert.ok(format.exists, `Missing format: ${formatName}`);
          assert.equal(format.mod, 'champions', 'Must use Champions mod');
          assert.ok(format.ruleset.includes('Flat Rules'), 'Flat Rules missing');
          assert.ok(format.ruleset.includes('VGC Timer'), 'VGC Timer missing');
          const mod = Dex.forFormat(format);
          assert.equal(mod.gen, 9, 'Champions gen mismatch');
          assert.ok(mod.data.Scripts, 'Champions scripts not loaded');
          assert.equal(typeof mod.data.Scripts.statModify, 'function', '66P stat script missing');
          assert.ok(mod.moves.get('tackle').exists, 'Move data not loaded');
          console.log('PASS CHAMPIONS_MOD_LOADED=true');
          console.log(`PASS MC_SINGLES_FORMAT=${format.name}`);
          console.log(`PASS CHAMPIONS_GEN=${mod.gen}`);
          console.log('PASS CHAMPIONS_STAT_MODIFY=function');
          NODE

      - name: Print verification boundary
        shell: bash
        run: |
          echo 'RESULT: pinned public Showdown source, npm ci/build, Champions Mod import checked.'
          echo 'NOT CERTIFIED: Native33=0/33; Exact34=0/34; Stage/Gate unchanged.'
