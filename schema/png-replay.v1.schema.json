{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:trueplan:screen-read:png-replay:v1",
  "title": "Offline exact PNG shared-reader evidence; no capture or game certification",
  "type": "object",
  "required": [
    "schema",
    "policy_id",
    "sample_id",
    "source_kind",
    "input_sha256",
    "input_png_bytes",
    "image_width",
    "image_height",
    "app_version",
    "app_build",
    "status",
    "processing_time",
    "capture_time_calibrated",
    "owner_certified",
    "identity_certified",
    "current_state_eligible",
    "battle_advice_authorized",
    "game_accuracy_certified",
    "device_certified",
    "reader_policy_version"
  ],
  "properties": {
    "schema": {
      "const": "trueplan.screen-read.png-replay.v1"
    },
    "policy_id": {
      "const": "EXACT_PNG_SHARED_READER_OFFLINE_V1"
    },
    "sample_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "source_kind": {
      "const": "OFFLINE_EXACT_PNG"
    },
    "input_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "input_png_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 12000000
    },
    "image_width": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3072
    },
    "image_height": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3072
    },
    "app_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "app_build": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,8}$"
    },
    "status": {
      "enum": [
        "SUCCESS",
        "FAILED"
      ]
    },
    "processing_time": {
      "type": "object",
      "required": [
        "clock_basis",
        "scope",
        "elapsed_ms"
      ],
      "properties": {
        "clock_basis": {
          "const": "HOST_MONOTONIC_ELAPSED"
        },
        "scope": {
          "const": "OCR_REQUEST"
        },
        "elapsed_ms": {
          "type": "number",
          "minimum": 0,
          "maximum": 3600000
        }
      },
      "additionalProperties": false
    },
    "capture_time_calibrated": {
      "const": false,
      "type": "boolean"
    },
    "owner_certified": {
      "const": false,
      "type": "boolean"
    },
    "identity_certified": {
      "const": false,
      "type": "boolean"
    },
    "current_state_eligible": {
      "const": false,
      "type": "boolean"
    },
    "battle_advice_authorized": {
      "const": false,
      "type": "boolean"
    },
    "game_accuracy_certified": {
      "const": false,
      "type": "boolean"
    },
    "device_certified": {
      "const": false,
      "type": "boolean"
    },
    "reader_policy_version": {
      "const": "r574.png-replay.v1"
    }
  },
  "additionalProperties": false
}
