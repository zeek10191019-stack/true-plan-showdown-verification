{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Current stream input health diagnostics only",
  "type": "object",
  "properties": {
    "schema": {
      "const": "trueplan.screen-read.input-health.v1"
    },
    "scope": {
      "const": "CURRENT_STREAM_DIAGNOSTICS_NOT_SELECTED_FRAME_PROOF"
    },
    "status": {
      "enum": [
        "NOT_OBSERVED",
        "READY_DELIVERY_ONLY",
        "INPUT_HELD"
      ]
    },
    "accepted_inputs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "rejected_inputs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "consecutive_rejections": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "retirement_requests": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "last_reason": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "enum": [
            "CURRENT_SCREEN_IMAGE_MISSING",
            "CURRENT_STREAM_CONTINUITY_REJECTED",
            "CURRENT_STREAM_INGRESS_REJECTED",
            "INVALID_CURRENT_SCREEN_SAMPLE"
          ]
        }
      ]
    },
    "capture_timestamp_calibrated": {
      "const": false,
      "type": "boolean"
    },
    "current_state_eligible": {
      "const": false,
      "type": "boolean"
    },
    "owner_certified": {
      "const": false,
      "type": "boolean"
    },
    "battle_advice_authorized": {
      "const": false,
      "type": "boolean"
    }
  },
  "required": [
    "schema",
    "scope",
    "status",
    "accepted_inputs",
    "rejected_inputs",
    "consecutive_rejections",
    "retirement_requests",
    "last_reason",
    "capture_timestamp_calibrated",
    "current_state_eligible",
    "owner_certified",
    "battle_advice_authorized"
  ],
  "additionalProperties": false
}
