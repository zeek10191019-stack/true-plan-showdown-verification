{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:trueplan:screen-read:candidate-lease:v1",
  "title": "Receipt diagnostics only; no capture-time, ownership or game-current certification",
  "type": "object",
  "required": [
    "host_now_ms",
    "last_clock_ms",
    "scope_revision",
    "last_request_id",
    "last_issued_frame_id",
    "last_issued_receipt_ms",
    "accepted_results",
    "rejected_operations",
    "duplicate_png_digests_not_refreshed",
    "invalidations",
    "schema",
    "scope",
    "clock_basis",
    "ttl_ms",
    "active",
    "capture_session_id",
    "epoch",
    "pending",
    "latest",
    "view_status",
    "last_reason",
    "source_image_attached",
    "owner_certified",
    "current_state_eligible",
    "battle_advice_authorized",
    "battle_id",
    "turn",
    "capture_timestamp_ms"
  ],
  "properties": {
    "host_now_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "last_clock_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "scope_revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "last_request_id": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "last_issued_frame_id": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "last_issued_receipt_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "accepted_results": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "rejected_operations": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "duplicate_png_digests_not_refreshed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "invalidations": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "schema": {
      "const": "trueplan.screen-read.candidate-lease.v1"
    },
    "scope": {
      "const": "HOST_RECEIPT_DIAGNOSTICS_ONLY"
    },
    "clock_basis": {
      "const": "UNCALIBRATED_HOST_RECEIPT_UPTIME"
    },
    "ttl_ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 30000
    },
    "active": {
      "type": "boolean"
    },
    "capture_session_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 128
    },
    "epoch": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "pending": {
      "type": [
        "object",
        "null"
      ]
    },
    "latest": {
      "type": [
        "object",
        "null"
      ]
    },
    "view_status": {
      "enum": [
        "STOPPED",
        "PENDING",
        "EMPTY",
        "FRESH_RECEIPT_ONLY",
        "EXPIRED"
      ]
    },
    "last_reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "source_image_attached": {
      "const": false
    },
    "owner_certified": {
      "const": false
    },
    "current_state_eligible": {
      "const": false
    },
    "battle_advice_authorized": {
      "const": false
    },
    "battle_id": {
      "type": "null"
    },
    "turn": {
      "type": "null"
    },
    "capture_timestamp_ms": {
      "type": "null"
    },
    "strict_retirement_on_new_request": {
      "type": "boolean",
      "description": "Optional legacy-compatible R570 mode. A pending request retires the previous display candidate."
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "required": [
          "strict_retirement_on_new_request"
        ],
        "properties": {
          "strict_retirement_on_new_request": {
            "const": true
          }
        }
      },
      "then": {
        "anyOf": [
          {
            "properties": {
              "pending": {
                "type": "null"
              }
            }
          },
          {
            "properties": {
              "latest": {
                "type": "null"
              }
            }
          }
        ]
      }
    }
  ]
}
