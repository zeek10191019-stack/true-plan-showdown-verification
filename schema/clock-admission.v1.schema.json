{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "schema",
    "policy_id",
    "scope",
    "epoch",
    "frame_id",
    "delivered_uptime_ms",
    "previous_delivered_uptime_ms",
    "delivery_delta_ms",
    "pts_verdict",
    "action",
    "reason",
    "allows_automatic_ocr",
    "requires_new_epoch",
    "capture_timestamp_calibrated",
    "owner_certified",
    "current_state_eligible",
    "battle_advice_authorized"
  ],
  "properties": {
    "schema": {
      "const": "trueplan.screen-read.clock-admission.v1"
    },
    "policy_id": {
      "const": "RELATIVE_PTS_FENCE_V1"
    },
    "scope": {
      "const": "LAST_CALLBACK_CLOCK_DIAGNOSTICS_NOT_SELECTED_FRAME_CERTIFICATION"
    },
    "epoch": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "frame_id": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "delivered_uptime_ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "previous_delivered_uptime_ms": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        {
          "type": "null"
        }
      ]
    },
    "delivery_delta_ms": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": -9223372036854775807,
          "maximum": 9223372036854775807
        },
        {
          "type": "null"
        }
      ]
    },
    "pts_verdict": {
      "enum": [
        "PTS_DELIVERY_CLOCK_ROLLBACK_HOLD",
        "PTS_DELTA_DIVERGENCE_HOLD",
        "PTS_EPOCH_MISMATCH_HOLD",
        "PTS_FRAME_REPLAY_HOLD",
        "PTS_FRAME_ROLLBACK_HOLD",
        "PTS_INVALID_STAMP_HOLD",
        "PTS_MISSING_OR_UNCALIBRATED_HOLD",
        "PTS_REPEATED_HOLD",
        "PTS_ROLLBACK_HOLD",
        "PTS_STREAM_NOT_STARTED_HOLD",
        "RELATIVE_PTS_ORDER_ONLY_UNCERTIFIED"
      ]
    },
    "action": {
      "enum": [
        "ALLOW_RELATIVE_ONLY",
        "HOLD_AUTOMATIC_OCR",
        "RETIRE_READ_SCOPE"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "allows_automatic_ocr": {
      "type": "boolean"
    },
    "requires_new_epoch": {
      "type": "boolean"
    },
    "capture_timestamp_calibrated": {
      "const": false
    },
    "owner_certified": {
      "const": false
    },
    "current_state_eligible": {
      "const": false
    },
    "battle_advice_authorized": {
      "const": false
    }
  },
  "additionalProperties": false
}
