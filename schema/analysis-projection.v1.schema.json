{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Declared historical image geometry; never game/owner certification",
  "type": "object",
  "required": [
    "schema",
    "status",
    "capture_session_id",
    "frame_id",
    "epoch",
    "receipt_uptime_ms",
    "raw_image_sha256",
    "analysis_image_sha256",
    "raw_width",
    "raw_height",
    "pixel_crop",
    "quarter_turns_ccw",
    "analysis_width",
    "analysis_height",
    "coordinate_convention",
    "transform",
    "pixel_equality_verified",
    "game_orientation_certified",
    "owner_certified",
    "current_state_eligible",
    "battle_advice_authorized",
    "battle_id",
    "turn",
    "mapped_rois",
    "omitted_rois"
  ],
  "properties": {
    "schema": {
      "const": "trueplan.screen-read.analysis-projection.v1"
    },
    "status": {
      "enum": [
        "DECLARED_GEOMETRY_ONLY",
        "HOLD"
      ]
    },
    "capture_session_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "frame_id": {
      "type": "integer",
      "minimum": 1
    },
    "epoch": {
      "type": "integer",
      "minimum": 1
    },
    "receipt_uptime_ms": {
      "type": "integer",
      "minimum": 1
    },
    "raw_image_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "analysis_image_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "raw_width": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3072
    },
    "raw_height": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3072
    },
    "analysis_width": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3072
    },
    "analysis_height": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3072
    },
    "pixel_crop": {
      "$ref": "#/definitions/rect"
    },
    "quarter_turns_ccw": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3
    },
    "coordinate_convention": {
      "const": "HALF_OPEN_PIXELS_TOP_LEFT"
    },
    "transform": {
      "const": "INTEGER_CROP_THEN_CCW_QUARTER_TURN"
    },
    "pixel_equality_verified": {
      "const": false
    },
    "game_orientation_certified": {
      "const": false
    },
    "owner_certified": {
      "const": false
    },
    "current_state_eligible": {
      "const": false
    },
    "battle_advice_authorized": {
      "const": false
    },
    "battle_id": {
      "type": "null"
    },
    "turn": {
      "type": "null"
    },
    "mapped_rois": {
      "type": "array",
      "maxItems": 512,
      "items": {
        "type": "object",
        "required": [
          "evidence_ref",
          "analysis_rect",
          "raw_rect"
        ],
        "additionalProperties": false,
        "properties": {
          "evidence_ref": {
            "type": "string"
          },
          "analysis_rect": {
            "$ref": "#/definitions/rect"
          },
          "raw_rect": {
            "$ref": "#/definitions/rect"
          }
        }
      }
    },
    "omitted_rois": {
      "type": "array",
      "maxItems": 512,
      "items": {
        "type": "object",
        "required": [
          "evidence_ref",
          "reason"
        ],
        "additionalProperties": false,
        "properties": {
          "evidence_ref": {
            "type": "string"
          },
          "reason": {
            "const": "ROI_MISSING_OR_UNBOUND"
          }
        }
      }
    }
  },
  "definitions": {
    "rect": {
      "type": "object",
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "additionalProperties": false,
      "properties": {
        "x": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3072
        },
        "y": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3072
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3072
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3072
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "const": "HOLD"
          }
        }
      },
      "then": {
        "properties": {
          "mapped_rois": {
            "maxItems": 0
          },
          "omitted_rois": {
            "maxItems": 0
          }
        }
      }
    }
  ]
}
