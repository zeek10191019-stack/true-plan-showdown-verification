{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "schema",
    "scope",
    "capacity",
    "active_requests",
    "last_ticket",
    "active_ticket",
    "available",
    "owner_certified",
    "current_state_eligible",
    "battle_advice_authorized"
  ],
  "properties": {
    "schema": {
      "const": "trueplan.screen-read.live-work-slot.v1"
    },
    "scope": {
      "const": "ONE_LIVE_OCR_WORKER_ACROSS_CAPTURE_EPOCHS"
    },
    "capacity": {
      "const": 1,
      "type": "integer"
    },
    "active_requests": {
      "enum": [
        0,
        1
      ],
      "type": "integer"
    },
    "last_ticket": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "active_ticket": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        {
          "type": "null"
        }
      ]
    },
    "available": {
      "type": "boolean"
    },
    "owner_certified": {
      "const": false
    },
    "current_state_eligible": {
      "const": false
    },
    "battle_advice_authorized": {
      "const": false
    }
  },
  "additionalProperties": false
}
