{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:trueplan:ocr:vision-input:v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "trueplan.ocr.vision-input.v1"
    },
    "handler": {
      "const": "CVPIXELBUFFER_BGRA8_UP"
    },
    "normalization": {
      "const": "SRGB8_WHITE_COMPOSITE_NO_GEOMETRY_CHANGE"
    },
    "source_pixel_equality_certified": {
      "const": false
    },
    "width": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3072
    },
    "height": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3072
    },
    "bytes_per_row": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16384
    },
    "allocation_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20000000
    },
    "visible_pixel_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 18000000
    },
    "visible_pixel_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "allocation_bytes",
    "bytes_per_row",
    "handler",
    "height",
    "normalization",
    "schema",
    "source_pixel_equality_certified",
    "visible_pixel_bytes",
    "visible_pixel_sha256",
    "width"
  ]
}
