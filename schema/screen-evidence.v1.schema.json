{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:trueplan:screen-read:screen-evidence:v1",
  "title": "Source-bound historical screen classification candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "policy_id",
    "capture_session_id",
    "frame_id",
    "epoch",
    "image_sha256",
    "receipt_uptime_ms",
    "battle_id",
    "turn",
    "scope",
    "roi_coordinate_space",
    "status",
    "primary_kind",
    "all_variants_kind",
    "screen_kind",
    "declared_packet_kind",
    "evaluated_evidence_refs",
    "omitted_reading_refs",
    "owner_certified",
    "game_accuracy_certified",
    "current_state_eligible",
    "battle_advice_authorized"
  ],
  "properties": {
    "schema": {
      "const": "trueplan.screen-read.screen-evidence.v1"
    },
    "policy_id": {
      "const": "STRICT_LABELS_BOUND_ROIS_ALL_VARIANTS_V1"
    },
    "capture_session_id": {
      "type": "string",
      "minLength": 1
    },
    "frame_id": {
      "type": "integer",
      "minimum": 1
    },
    "epoch": {
      "type": "integer",
      "minimum": 1
    },
    "image_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "receipt_uptime_ms": {
      "type": "integer",
      "minimum": 1
    },
    "battle_id": {
      "type": "null"
    },
    "turn": {
      "type": "null"
    },
    "scope": {
      "const": "HISTORICAL_TEXT_SCREEN_CANDIDATES_ONLY"
    },
    "roi_coordinate_space": {
      "const": "ANALYSIS_PIXELS_TOP_LEFT"
    },
    "status": {
      "enum": [
        "PRIMARY_AND_ALTERNATIVES_AGREE",
        "HOLD_UNKNOWN_PRIMARY",
        "HOLD_OCR_SCREEN_CONFLICT",
        "HOLD_PACKET_KIND_DISAGREEMENT",
        "HOLD_MALFORMED_PACKET_KIND"
      ]
    },
    "primary_kind": {
      "$ref": "#/definitions/kind"
    },
    "all_variants_kind": {
      "$ref": "#/definitions/kind"
    },
    "screen_kind": {
      "$ref": "#/definitions/kind"
    },
    "declared_packet_kind": {},
    "evaluated_evidence_refs": {
      "type": "array",
      "maxItems": 1536,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^payload_json\\.readings\\[[0-9]+\\](\\.ocr_alternatives\\[[12]\\])?$"
      }
    },
    "omitted_reading_refs": {
      "type": "array",
      "maxItems": 512,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^payload_json\\.readings\\[[0-9]+\\]$"
      }
    },
    "owner_certified": {
      "const": false
    },
    "game_accuracy_certified": {
      "const": false
    },
    "current_state_eligible": {
      "const": false
    },
    "battle_advice_authorized": {
      "const": false
    }
  },
  "definitions": {
    "kind": {
      "enum": [
        "unknown",
        "move_selection_candidate",
        "move_selection_with_move_details_overlay_candidate",
        "normal_command_candidate",
        "party_selection_candidate",
        "party_preview_candidate",
        "switch_selection_candidate",
        "battle_end_candidate",
        "animation_or_battle_message_candidate"
      ]
    }
  }
}
