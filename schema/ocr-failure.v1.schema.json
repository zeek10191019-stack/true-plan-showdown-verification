{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:trueplan:ocr:failure:v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "trueplan.ocr.failure.v1"
    },
    "status": {
      "const": "OCR_FAILED_NO_RESULT"
    },
    "execution_attestation": {
      "const": "SELF_REPORTED_NO_SIGNATURE"
    },
    "automatic_retry_count": {
      "type": "integer",
      "enum": [
        0,
        1
      ]
    },
    "raw_error_messages_included": {
      "const": false
    },
    "current_state_eligible": {
      "const": false
    },
    "owner_certified": {
      "const": false
    },
    "ocr_accuracy_certified": {
      "const": false
    },
    "battle_advice_authorized": {
      "const": false
    },
    "capture_session_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "frame_id": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "epoch": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "receipt_uptime_ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "attempted_image_width": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3072
    },
    "attempted_image_height": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3072
    },
    "attempted_image_sha256": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      ]
    },
    "error_codes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "domain",
          "code"
        ],
        "properties": {
          "domain": {
            "enum": [
              "NSCocoaErrorDomain",
              "NSOSStatusErrorDomain",
              "NSPOSIXErrorDomain",
              "OTHER_ERROR_DOMAIN",
              "TextRecognition.CRImageReaderError",
              "VNErrorDomain",
              "com.apple.Vision"
            ]
          },
          "code": {
            "type": "integer",
            "minimum": -9223372036854775808,
            "maximum": 9223372036854775807
          }
        }
      }
    },
    "recovery_audit": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "trueplan.ocr.execution.v1"
        },
        "policy_id": {
          "const": "DEFAULT_THEN_CPU_SOFTWARE_ON_IMAGE_ERROR_9_V1"
        },
        "same_input_reused": {
          "const": true
        },
        "configuration_only": {
          "const": true
        },
        "compute_execution_attested": {
          "const": false
        },
        "ocr_accuracy_certified": {
          "const": false
        },
        "owner_certified": {
          "const": false
        },
        "current_state_eligible": {
          "const": false
        },
        "battle_advice_authorized": {
          "const": false
        },
        "status": {
          "enum": [
            "SUCCEEDED",
            "FAILED"
          ]
        },
        "attempt_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2
        },
        "attempts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "mode": {
                "enum": [
                  "FRAMEWORK_DEFAULT",
                  "CPU_SOFTWARE"
                ]
              },
              "outcome": {
                "enum": [
                  "SUCCEEDED",
                  "REQUEST_FAILED",
                  "CONFIGURATION_FAILED"
                ]
              },
              "error_codes": {
                "type": "array",
                "maxItems": 4,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "domain",
                    "code"
                  ],
                  "properties": {
                    "domain": {
                      "enum": [
                        "NSCocoaErrorDomain",
                        "NSOSStatusErrorDomain",
                        "NSPOSIXErrorDomain",
                        "OTHER_ERROR_DOMAIN",
                        "TextRecognition.CRImageReaderError",
                        "VNErrorDomain",
                        "com.apple.Vision"
                      ]
                    },
                    "code": {
                      "type": "integer",
                      "minimum": -9223372036854775808,
                      "maximum": 9223372036854775807
                    }
                  }
                }
              },
              "configuration_accepted": {
                "type": "boolean"
              },
              "request_performed": {
                "type": "boolean"
              },
              "main_stage_present": {
                "type": "boolean"
              },
              "software_context_requested": {
                "type": "boolean"
              },
              "supported_stage_count": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9223372036854775807
              },
              "cpu_assigned_stage_count": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9223372036854775807
              }
            },
            "required": [
              "configuration_accepted",
              "cpu_assigned_stage_count",
              "error_codes",
              "main_stage_present",
              "mode",
              "outcome",
              "request_performed",
              "software_context_requested",
              "supported_stage_count"
            ]
          }
        }
      },
      "required": [
        "attempt_count",
        "attempts",
        "battle_advice_authorized",
        "compute_execution_attested",
        "configuration_only",
        "current_state_eligible",
        "ocr_accuracy_certified",
        "owner_certified",
        "policy_id",
        "same_input_reused",
        "schema",
        "status"
      ]
    }
  },
  "required": [
    "attempted_image_height",
    "attempted_image_sha256",
    "attempted_image_width",
    "automatic_retry_count",
    "battle_advice_authorized",
    "capture_session_id",
    "current_state_eligible",
    "epoch",
    "error_codes",
    "execution_attestation",
    "frame_id",
    "ocr_accuracy_certified",
    "owner_certified",
    "raw_error_messages_included",
    "receipt_uptime_ms",
    "schema",
    "status"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "automatic_retry_count": {
            "const": 1
          }
        }
      },
      "then": {
        "required": [
          "recovery_audit"
        ]
      }
    }
  ]
}
