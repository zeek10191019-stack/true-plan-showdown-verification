{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:trueplan:source-bound-hints:v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "scope",
    "capture_session_id",
    "frame_id",
    "epoch",
    "image_sha256",
    "hints",
    "battle_id",
    "turn",
    "owner_certified",
    "identity_certified",
    "current_state_eligible",
    "battle_advice_authorized",
    "game_accuracy_certified",
    "iPhone_accuracy_certified",
    "source_evidence_checked",
    "role_text_checked",
    "evidence_group_checked",
    "semantic_consensus_checked",
    "literal_values_checked"
  ],
  "properties": {
    "schema": {
      "const": "trueplan.screen-read.source-bound-hints.v2"
    },
    "status": {
      "anyOf": [
        {
          "const": "PROVISIONAL_SOURCE_BOUND_HINTS_NO_OWNER_CERTIFICATION"
        },
        {
          "type": "string",
          "pattern": "^HOLD_[A-Z0-9_]+$"
        }
      ]
    },
    "scope": {
      "const": "SINGLE_HISTORICAL_FRAME_HINTS_ONLY"
    },
    "capture_session_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "frame_id": {
      "type": "integer",
      "minimum": 1
    },
    "epoch": {
      "type": "integer",
      "minimum": 1
    },
    "image_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "hints": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "$ref": "#/definitions/sourceBoundHint"
      }
    },
    "battle_id": {
      "type": "null"
    },
    "turn": {
      "type": "null"
    },
    "source_evidence_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 384
    },
    "owner_certified": {
      "const": false
    },
    "identity_certified": {
      "const": false
    },
    "current_state_eligible": {
      "const": false
    },
    "battle_advice_authorized": {
      "const": false
    },
    "game_accuracy_certified": {
      "const": false
    },
    "iPhone_accuracy_certified": {
      "const": false
    },
    "source_evidence_checked": {
      "type": "boolean"
    },
    "role_text_checked": {
      "type": "boolean"
    },
    "evidence_group_checked": {
      "type": "boolean"
    },
    "semantic_consensus_checked": {
      "type": "boolean"
    },
    "literal_values_checked": {
      "type": "boolean"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "PROVISIONAL_SOURCE_BOUND_HINTS_NO_OWNER_CERTIFICATION"
          }
        }
      },
      "then": {
        "required": [
          "source_evidence_count"
        ],
        "properties": {
          "source_evidence_checked": {
            "const": true
          },
          "role_text_checked": {
            "const": true
          },
          "evidence_group_checked": {
            "const": true
          },
          "semantic_consensus_checked": {
            "const": true
          },
          "literal_values_checked": {
            "const": true
          },
          "hints": {
            "minItems": 1
          }
        }
      },
      "else": {
        "properties": {
          "source_evidence_checked": {
            "const": false
          },
          "role_text_checked": {
            "const": false
          },
          "evidence_group_checked": {
            "const": false
          },
          "semantic_consensus_checked": {
            "const": false
          },
          "literal_values_checked": {
            "const": false
          },
          "hints": {
            "maxItems": 0
          }
        },
        "not": {
          "required": [
            "source_evidence_count"
          ]
        }
      }
    }
  ],
  "definitions": {
    "sourceBoundHint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role_hint",
        "suggested_side",
        "slot",
        "evidence_refs",
        "rois",
        "knowledge_state",
        "verification",
        "current_state_eligible",
        "literal_value",
        "raw_texts",
        "source_confidences",
        "value_basis",
        "side",
        "owner_certified",
        "identity_certified",
        "validity"
      ],
      "properties": {
        "role_hint": {
          "enum": [
            "own_hp",
            "opponent_hp",
            "own_name",
            "opponent_name",
            "move_name",
            "move_pp"
          ]
        },
        "suggested_side": {
          "enum": [
            "own",
            "opponent"
          ]
        },
        "slot": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 3
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^payload_json\\.readings\\[[0-9]+\\](?:\\.ocr_alternatives\\[[12]\\])?$"
          }
        },
        "rois": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "x",
              "y",
              "width",
              "height"
            ],
            "properties": {
              "x": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4096
              },
              "y": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4096
              },
              "width": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4096
              },
              "height": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4096
              }
            }
          }
        },
        "knowledge_state": {
          "const": "INFERRED"
        },
        "verification": {
          "const": "POSITION_ONLY_UNVERIFIED"
        },
        "current_state_eligible": {
          "const": false
        },
        "literal_value": {},
        "raw_texts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "source_confidences": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1
          }
        },
        "value_basis": {
          "const": "OCR_LITERAL_CONSENSUS_ONLY"
        },
        "side": {
          "const": "UNKNOWN_OWNER"
        },
        "owner_certified": {
          "const": false
        },
        "identity_certified": {
          "const": false
        },
        "validity": {
          "const": "HISTORICAL_FRAME_ONLY"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "role_hint": {
                "enum": [
                  "own_hp"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "literal_value": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "current",
                  "maximum"
                ],
                "properties": {
                  "current": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9999
                  },
                  "maximum": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9999
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "role_hint": {
                "enum": [
                  "opponent_hp"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "literal_value": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "current",
                      "maximum"
                    ],
                    "properties": {
                      "current": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9999
                      },
                      "maximum": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 9999
                      }
                    }
                  },
                  {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "role_hint": {
                "enum": [
                  "move_pp"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "literal_value": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "current",
                  "maximum"
                ],
                "properties": {
                  "current": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9999
                  },
                  "maximum": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9999
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "role_hint": {
                "enum": [
                  "own_name",
                  "opponent_name",
                  "move_name"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "literal_value": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "role_hint": {
                "enum": [
                  "move_name",
                  "move_pp"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "slot": {
                "type": "integer",
                "minimum": 0,
                "maximum": 3
              }
            }
          },
          "else": {
            "properties": {
              "slot": {
                "type": "null"
              }
            }
          }
        }
      ]
    }
  }
}
