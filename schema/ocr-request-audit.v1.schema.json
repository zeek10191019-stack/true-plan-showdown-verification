{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:trueplan:ocr:request-audit:v1",
  "title": "Self-reported bounded OCR request metadata; no accuracy or execution attestation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "battle_advice_authorized",
    "capture_session_id",
    "current_state_eligible",
    "device_certified",
    "effective_recognition_level",
    "effective_supported_languages",
    "emitted_region_count",
    "engine_version",
    "epoch",
    "examined_region_count",
    "execution_attestation",
    "fast_language_check",
    "fast_supported_languages",
    "frame_id",
    "image_height",
    "image_sha256",
    "image_width",
    "input_binding",
    "maximum_candidates_per_region",
    "maximum_regions",
    "ocr_accuracy_certified",
    "omitted_observations",
    "owner_certified",
    "raw_region_count",
    "receipt_uptime_ms",
    "request_revision",
    "requested_languages",
    "requested_mode",
    "schema",
    "scope",
    "timestamp_basis",
    "truncated_region_count",
    "unbound_roi_count",
    "uses_language_correction"
  ],
  "properties": {
    "schema": {
      "const": "trueplan.ocr.request-audit.v1"
    },
    "engine_version": {
      "enum": [
        "r558.full-frame.v1",
        "r559.full-frame.v2",
        "r560.full-frame.v3"
      ]
    },
    "scope": {
      "const": "PROVISIONAL_TEXT_REQUEST_ONLY"
    },
    "input_binding": {
      "const": "EXACT_PNG_BYTES_DECODED_UP"
    },
    "execution_attestation": {
      "const": "SELF_REPORTED_NO_SIGNATURE"
    },
    "timestamp_basis": {
      "const": "UNCALIBRATED_HOST_RECEIPT_UPTIME"
    },
    "uses_language_correction": {
      "const": false
    },
    "maximum_regions": {
      "const": 96
    },
    "maximum_candidates_per_region": {
      "const": 3
    },
    "ocr_accuracy_certified": {
      "const": false
    },
    "device_certified": {
      "const": false
    },
    "owner_certified": {
      "const": false
    },
    "current_state_eligible": {
      "const": false
    },
    "battle_advice_authorized": {
      "const": false
    },
    "capture_session_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "image_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "requested_mode": {
      "enum": [
        "MANUAL_ACCURATE",
        "AUTOMATIC_SPEED_PRIORITY"
      ]
    },
    "effective_recognition_level": {
      "enum": [
        "accurate",
        "fast"
      ]
    },
    "requested_languages": {
      "const": [
        "ja-JP",
        "en-US"
      ]
    },
    "fast_language_check": {
      "enum": [
        "NOT_REQUESTED",
        "SUPPORTED",
        "UNSUPPORTED",
        "QUERY_FAILED"
      ]
    },
    "frame_id": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "epoch": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "receipt_uptime_ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "request_revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "image_width": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3072
    },
    "image_height": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3072
    },
    "raw_region_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "truncated_region_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "examined_region_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 96
    },
    "emitted_region_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 96
    },
    "unbound_roi_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 96
    },
    "fast_supported_languages": {
      "type": "array",
      "maxItems": 1024,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    },
    "effective_supported_languages": {
      "type": "array",
      "maxItems": 1024,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "allOf": [
        {
          "contains": {
            "const": "ja-JP"
          }
        },
        {
          "contains": {
            "const": "en-US"
          }
        }
      ]
    },
    "omitted_observations": {
      "type": "array",
      "maxItems": 96,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "observation_index",
          "reason"
        ],
        "properties": {
          "observation_index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 95
          },
          "reason": {
            "enum": [
              "NO_TEXT_CANDIDATE",
              "INVALID_TEXT_OR_CONFIDENCE",
              "INVALID_ALTERNATIVE_ORDER"
            ]
          }
        }
      }
    },
    "vision_input": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "trueplan.ocr.vision-input.v1"
        },
        "handler": {
          "const": "CVPIXELBUFFER_BGRA8_UP"
        },
        "normalization": {
          "const": "SRGB8_WHITE_COMPOSITE_NO_GEOMETRY_CHANGE"
        },
        "source_pixel_equality_certified": {
          "const": false
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3072
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3072
        },
        "bytes_per_row": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16384
        },
        "allocation_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20000000
        },
        "visible_pixel_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 18000000
        },
        "visible_pixel_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "allocation_bytes",
        "bytes_per_row",
        "handler",
        "height",
        "normalization",
        "schema",
        "source_pixel_equality_certified",
        "visible_pixel_bytes",
        "visible_pixel_sha256",
        "width"
      ]
    },
    "execution_audit": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "trueplan.ocr.execution.v1"
        },
        "policy_id": {
          "const": "DEFAULT_THEN_CPU_SOFTWARE_ON_IMAGE_ERROR_9_V1"
        },
        "same_input_reused": {
          "const": true
        },
        "configuration_only": {
          "const": true
        },
        "compute_execution_attested": {
          "const": false
        },
        "ocr_accuracy_certified": {
          "const": false
        },
        "owner_certified": {
          "const": false
        },
        "current_state_eligible": {
          "const": false
        },
        "battle_advice_authorized": {
          "const": false
        },
        "status": {
          "enum": [
            "SUCCEEDED",
            "FAILED"
          ]
        },
        "attempt_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2
        },
        "attempts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "mode": {
                "enum": [
                  "FRAMEWORK_DEFAULT",
                  "CPU_SOFTWARE"
                ]
              },
              "outcome": {
                "enum": [
                  "SUCCEEDED",
                  "REQUEST_FAILED",
                  "CONFIGURATION_FAILED"
                ]
              },
              "error_codes": {
                "type": "array",
                "maxItems": 4,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "domain",
                    "code"
                  ],
                  "properties": {
                    "domain": {
                      "enum": [
                        "NSCocoaErrorDomain",
                        "NSOSStatusErrorDomain",
                        "NSPOSIXErrorDomain",
                        "OTHER_ERROR_DOMAIN",
                        "TextRecognition.CRImageReaderError",
                        "VNErrorDomain",
                        "com.apple.Vision"
                      ]
                    },
                    "code": {
                      "type": "integer",
                      "minimum": -9223372036854775808,
                      "maximum": 9223372036854775807
                    }
                  }
                }
              },
              "configuration_accepted": {
                "type": "boolean"
              },
              "request_performed": {
                "type": "boolean"
              },
              "main_stage_present": {
                "type": "boolean"
              },
              "software_context_requested": {
                "type": "boolean"
              },
              "supported_stage_count": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9223372036854775807
              },
              "cpu_assigned_stage_count": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9223372036854775807
              }
            },
            "required": [
              "configuration_accepted",
              "cpu_assigned_stage_count",
              "error_codes",
              "main_stage_present",
              "mode",
              "outcome",
              "request_performed",
              "software_context_requested",
              "supported_stage_count"
            ]
          }
        }
      },
      "required": [
        "attempt_count",
        "attempts",
        "battle_advice_authorized",
        "compute_execution_attested",
        "configuration_only",
        "current_state_eligible",
        "ocr_accuracy_certified",
        "owner_certified",
        "policy_id",
        "same_input_reused",
        "schema",
        "status"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "requested_mode"
        ],
        "properties": {
          "requested_mode": {
            "const": "MANUAL_ACCURATE"
          }
        }
      },
      "then": {
        "properties": {
          "effective_recognition_level": {
            "const": "accurate"
          },
          "fast_language_check": {
            "const": "NOT_REQUESTED"
          },
          "fast_supported_languages": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "requested_mode"
        ],
        "properties": {
          "requested_mode": {
            "const": "AUTOMATIC_SPEED_PRIORITY"
          }
        }
      },
      "then": {
        "properties": {
          "fast_language_check": {
            "enum": [
              "SUPPORTED",
              "UNSUPPORTED",
              "QUERY_FAILED"
            ]
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "fast_language_check"
        ],
        "properties": {
          "fast_language_check": {
            "const": "SUPPORTED"
          }
        }
      },
      "then": {
        "properties": {
          "effective_recognition_level": {
            "const": "fast"
          },
          "fast_supported_languages": {
            "allOf": [
              {
                "contains": {
                  "const": "ja-JP"
                }
              },
              {
                "contains": {
                  "const": "en-US"
                }
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "fast_language_check"
        ],
        "properties": {
          "fast_language_check": {
            "const": "UNSUPPORTED"
          }
        }
      },
      "then": {
        "properties": {
          "effective_recognition_level": {
            "const": "accurate"
          },
          "fast_supported_languages": {
            "not": {
              "allOf": [
                {
                  "contains": {
                    "const": "ja-JP"
                  }
                },
                {
                  "contains": {
                    "const": "en-US"
                  }
                }
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "fast_language_check"
        ],
        "properties": {
          "fast_language_check": {
            "const": "QUERY_FAILED"
          }
        }
      },
      "then": {
        "properties": {
          "effective_recognition_level": {
            "const": "accurate"
          },
          "fast_supported_languages": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "engine_version": {
            "const": "r558.full-frame.v1"
          }
        }
      },
      "then": {
        "allOf": [
          {
            "not": {
              "required": [
                "vision_input"
              ]
            }
          },
          {
            "not": {
              "required": [
                "execution_audit"
              ]
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "engine_version": {
            "const": "r559.full-frame.v2"
          }
        }
      },
      "then": {
        "required": [
          "vision_input"
        ],
        "allOf": [
          {
            "not": {
              "required": [
                "execution_audit"
              ]
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "engine_version": {
            "const": "r560.full-frame.v3"
          }
        }
      },
      "then": {
        "required": [
          "vision_input",
          "execution_audit"
        ]
      }
    }
  ]
}
