{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:trueplan:screen-read:snapshot:v1",
  "title": "Historical screen-read snapshot; no live or battle advice authorization",
  "type": "object",
  "required": [
    "schema",
    "capture_session_id",
    "battle_id",
    "frame_id",
    "epoch",
    "receipt_uptime_ms",
    "capture_timestamp_ms",
    "turn",
    "orientation",
    "image_sha256",
    "knowledge_state",
    "validity",
    "stale_deadline_ms",
    "current_state_eligible",
    "battle_advice_authorized",
    "own",
    "opponent",
    "field",
    "candidates",
    "source_validation"
  ],
  "properties": {
    "schema": {
      "const": "trueplan.screen-read.snapshot.v1"
    },
    "capture_session_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "battle_id": {
      "type": "null"
    },
    "frame_id": {
      "type": "integer",
      "minimum": 1
    },
    "epoch": {
      "type": "integer",
      "minimum": 1
    },
    "receipt_uptime_ms": {
      "type": "integer",
      "minimum": 1
    },
    "capture_timestamp_ms": {
      "type": "null"
    },
    "turn": {
      "type": "null"
    },
    "orientation": {
      "const": "ANALYSIS_UP_SOURCE_TRANSFORM_UNVERIFIED"
    },
    "image_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "knowledge_state": {
      "enum": [
        "OBSERVED",
        "DERIVED",
        "INFERRED",
        "UNKNOWN",
        "CONFLICT"
      ]
    },
    "validity": {
      "const": "HISTORICAL_FRAME_ONLY"
    },
    "stale_deadline_ms": {
      "type": "null"
    },
    "current_state_eligible": {
      "const": false
    },
    "battle_advice_authorized": {
      "const": false
    },
    "own": {
      "type": "object"
    },
    "opponent": {
      "type": "object"
    },
    "field": {
      "type": "object"
    },
    "source_validation": {
      "enum": [
        "HOLD",
        "PASS_FRAME_BINDING_ONLY"
      ]
    },
    "candidates": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "$ref": "#/$defs/candidate"
      }
    },
    "conflicts": {
      "type": "array",
      "maxItems": 8192,
      "items": {
        "$ref": "#/$defs/conflict"
      }
    },
    "layout_candidates": {
      "$ref": "#/$defs/layoutCandidates"
    }
  },
  "$defs": {
    "candidate": {
      "type": "object",
      "required": [
        "domain",
        "value",
        "knowledge_state",
        "raw_text",
        "normalized_text",
        "side",
        "battle_id",
        "capture_session_id",
        "frame_id",
        "epoch",
        "turn",
        "capture_timestamp_ms",
        "receipt_uptime_ms",
        "orientation",
        "image_sha256",
        "roi",
        "confidence",
        "source",
        "evidence_ref",
        "validity",
        "stale_deadline_ms",
        "verification_status",
        "current_state_eligible"
      ],
      "properties": {
        "domain": {
          "enum": [
            "hp",
            "pp",
            "hp_or_pp",
            "hp_percent",
            "weather",
            "terrain",
            "room",
            "screen_or_side_effect",
            "entry_hazard",
            "major_status",
            "visible_volatile",
            "mega_text",
            "absolute_boost",
            "visible_ability_label",
            "visible_item_label"
          ]
        },
        "knowledge_state": {
          "const": "INFERRED"
        },
        "raw_text": {
          "type": "string"
        },
        "side": {
          "const": "UNKNOWN_OWNER"
        },
        "battle_id": {
          "type": "null"
        },
        "capture_session_id": {
          "type": "string"
        },
        "frame_id": {
          "type": "integer",
          "minimum": 1
        },
        "epoch": {
          "type": "integer",
          "minimum": 1
        },
        "turn": {
          "type": "null"
        },
        "capture_timestamp_ms": {
          "type": "null"
        },
        "receipt_uptime_ms": {
          "type": "integer",
          "minimum": 1
        },
        "image_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "roi": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/roi"
            }
          ]
        },
        "confidence": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "evidence_ref": {
          "type": "string",
          "pattern": "^payload_json\\.readings\\[[0-9]+\\](?:\\.ocr_alternatives\\[[12]\\])?$"
        },
        "validity": {
          "const": "HISTORICAL_FRAME_ONLY"
        },
        "stale_deadline_ms": {
          "type": "null"
        },
        "verification_status": {
          "const": "UNVERIFIED"
        },
        "current_state_eligible": {
          "const": false
        },
        "ocr_rank": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        }
      }
    },
    "roi": {
      "type": "object",
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "properties": {
        "x": {
          "type": "integer",
          "minimum": 0
        },
        "y": {
          "type": "integer",
          "minimum": 0
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "fraction": {
      "type": "object",
      "required": [
        "current",
        "maximum"
      ],
      "properties": {
        "current": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9999
        },
        "maximum": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9999
        }
      },
      "additionalProperties": false
    },
    "timedValue": {
      "type": "object",
      "required": [
        "label",
        "remaining_turns",
        "duration_semantics"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "remaining_turns": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 99
        },
        "duration_semantics": {
          "enum": [
            "UNKNOWN",
            "EXPLICIT_REMAINING_CANDIDATE"
          ]
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "remaining_turns": {
                "type": "null"
              }
            }
          },
          "then": {
            "properties": {
              "duration_semantics": {
                "const": "UNKNOWN"
              }
            }
          },
          "else": {
            "properties": {
              "duration_semantics": {
                "const": "EXPLICIT_REMAINING_CANDIDATE"
              }
            }
          }
        }
      ]
    },
    "absoluteBoost": {
      "type": "object",
      "required": [
        "stat",
        "stage",
        "semantics"
      ],
      "properties": {
        "stat": {
          "enum": [
            "atk",
            "def",
            "spa",
            "spd",
            "spe",
            "accuracy",
            "evasion"
          ]
        },
        "stage": {
          "type": "integer",
          "minimum": -6,
          "maximum": 6
        },
        "semantics": {
          "const": "ABSOLUTE_DISPLAY_CANDIDATE"
        }
      },
      "additionalProperties": false
    },
    "statusValue": {
      "type": "object",
      "required": [
        "kind",
        "poison_severity",
        "scope"
      ],
      "properties": {
        "kind": {
          "enum": [
            "burn",
            "paralysis",
            "sleep",
            "freeze",
            "poison"
          ]
        },
        "poison_severity": {
          "enum": [
            null,
            "UNKNOWN",
            "BAD_POISON_TEXT_CANDIDATE"
          ]
        },
        "scope": {
          "const": "TEXT_LABEL_ONLY"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "poison"
              }
            }
          },
          "then": {
            "properties": {
              "poison_severity": {
                "enum": [
                  "UNKNOWN",
                  "BAD_POISON_TEXT_CANDIDATE"
                ]
              }
            }
          },
          "else": {
            "properties": {
              "poison_severity": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "visibleLabel": {
      "type": "object",
      "required": [
        "label",
        "visibility"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "visibility": {
          "const": "TEXT_LABEL_ONLY"
        }
      },
      "additionalProperties": false
    },
    "structuredCandidate": {
      "allOf": [
        {
          "$ref": "#/$defs/candidate"
        },
        {
          "if": {
            "properties": {
              "domain": {
                "enum": [
                  "hp",
                  "pp",
                  "hp_or_pp"
                ]
              }
            },
            "required": [
              "domain"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "$ref": "#/$defs/fraction"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "domain": {
                "enum": [
                  "hp_percent"
                ]
              }
            },
            "required": [
              "domain"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "domain": {
                "enum": [
                  "weather",
                  "terrain",
                  "room",
                  "screen_or_side_effect",
                  "visible_volatile"
                ]
              }
            },
            "required": [
              "domain"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "$ref": "#/$defs/timedValue"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "domain": {
                "enum": [
                  "absolute_boost"
                ]
              }
            },
            "required": [
              "domain"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "$ref": "#/$defs/absoluteBoost"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "domain": {
                "enum": [
                  "major_status"
                ]
              }
            },
            "required": [
              "domain"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "$ref": "#/$defs/statusValue"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "domain": {
                "enum": [
                  "visible_ability_label",
                  "visible_item_label"
                ]
              }
            },
            "required": [
              "domain"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "$ref": "#/$defs/visibleLabel"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "domain": {
                "enum": [
                  "entry_hazard",
                  "mega_text"
                ]
              }
            },
            "required": [
              "domain"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            }
          }
        }
      ]
    },
    "conflict": {
      "type": "object",
      "required": [
        "domain",
        "semantic_key",
        "capture_session_id",
        "frame_id",
        "epoch",
        "image_sha256",
        "roi",
        "knowledge_state",
        "scope",
        "reason",
        "side",
        "current_state_eligible",
        "candidate_indices",
        "evidence_refs"
      ],
      "properties": {
        "domain": {
          "type": "string"
        },
        "semantic_key": {
          "type": "string",
          "minLength": 1
        },
        "capture_session_id": {
          "type": "string",
          "minLength": 1
        },
        "frame_id": {
          "type": "integer",
          "minimum": 1
        },
        "epoch": {
          "type": "integer",
          "minimum": 1
        },
        "image_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "roi": {
          "$ref": "#/$defs/roi"
        },
        "knowledge_state": {
          "const": "CONFLICT"
        },
        "scope": {
          "const": "OCR_INTERPRETATION_ONLY"
        },
        "reason": {
          "const": "DIFFERENT_VALUES_SAME_BOUND_FRAME_AND_ROI"
        },
        "side": {
          "const": "UNKNOWN_OWNER"
        },
        "current_state_eligible": {
          "const": false
        },
        "candidate_indices": {
          "type": "array",
          "minItems": 2,
          "maxItems": 4096,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4095
          }
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 2,
          "maxItems": 4096,
          "items": {
            "type": "string",
            "pattern": "^payload_json\\.readings\\[[0-9]+\\](?:\\.ocr_alternatives\\[[12]\\])?$"
          }
        }
      },
      "additionalProperties": false
    },
    "layoutAssociation": {
      "type": "object",
      "required": [
        "role_hint",
        "slot",
        "suggested_owner",
        "side",
        "knowledge_state",
        "value",
        "capture_session_id",
        "frame_id",
        "epoch",
        "image_sha256",
        "receipt_uptime_ms",
        "battle_id",
        "turn",
        "capture_timestamp_ms",
        "stale_deadline_ms",
        "orientation",
        "roi_coordinate_space",
        "confidence",
        "source_confidences",
        "source",
        "evidence_refs",
        "raw_texts",
        "rois",
        "verification_status",
        "current_state_eligible",
        "validity",
        "method"
      ],
      "properties": {
        "role_hint": {
          "enum": [
            "own_hp",
            "opponent_hp",
            "own_name",
            "opponent_name",
            "move_name",
            "move_pp"
          ]
        },
        "slot": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 3
        },
        "suggested_owner": {
          "enum": [
            "own",
            "opponent"
          ]
        },
        "side": {
          "const": "UNKNOWN_OWNER"
        },
        "knowledge_state": {
          "enum": [
            "UNKNOWN",
            "INFERRED",
            "CONFLICT"
          ]
        },
        "value": {},
        "capture_session_id": {
          "type": "string",
          "minLength": 1
        },
        "frame_id": {
          "type": "integer",
          "minimum": 1
        },
        "epoch": {
          "type": "integer",
          "minimum": 1
        },
        "image_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "receipt_uptime_ms": {
          "type": "integer",
          "minimum": 1
        },
        "battle_id": {
          "type": "null"
        },
        "turn": {
          "type": "null"
        },
        "capture_timestamp_ms": {
          "type": "null"
        },
        "stale_deadline_ms": {
          "type": "null"
        },
        "orientation": {
          "const": "ANALYSIS_UP_SOURCE_TRANSFORM_UNVERIFIED"
        },
        "roi_coordinate_space": {
          "const": "ANALYSIS_PIXELS_TOP_LEFT"
        },
        "confidence": {
          "type": "null"
        },
        "source_confidences": {
          "type": "array",
          "maxItems": 1536,
          "items": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1
          }
        },
        "source": {
          "const": "VISION_OCR_LAYOUT_CANDIDATE"
        },
        "evidence_refs": {
          "type": "array",
          "maxItems": 1536,
          "items": {
            "type": "string",
            "pattern": "^payload_json\\.readings\\[[0-9]+\\](?:\\.ocr_alternatives\\[[12]\\])?$"
          }
        },
        "raw_texts": {
          "type": "array",
          "maxItems": 1536,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "rois": {
          "type": "array",
          "maxItems": 1536,
          "items": {
            "$ref": "#/$defs/roi"
          }
        },
        "verification_status": {
          "const": "UNVERIFIED"
        },
        "current_state_eligible": {
          "const": false
        },
        "validity": {
          "const": "HISTORICAL_FRAME_ONLY"
        },
        "method": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "knowledge_state": {
                "enum": [
                  "UNKNOWN",
                  "CONFLICT"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "layoutCandidates": {
      "type": "object",
      "required": [
        "schema",
        "profile_id",
        "status",
        "capture_session_id",
        "frame_id",
        "epoch",
        "image_sha256",
        "receipt_uptime_ms",
        "roi_coordinate_space",
        "scope",
        "calibration_certified",
        "owner_certified",
        "current_state_eligible",
        "battle_advice_authorized",
        "anchors",
        "associations",
        "conflict_count"
      ],
      "properties": {
        "schema": {
          "const": "trueplan.screen-read.layout-candidates.v1"
        },
        "profile_id": {
          "const": "LEGACY_VERTICAL_MOVES_216_V1"
        },
        "status": {
          "enum": [
            "HOLD_UNSUPPORTED_SCREEN",
            "HOLD_UNSUPPORTED_GEOMETRY",
            "HOLD_MISSING_ANCHORS",
            "HOLD_AMBIGUOUS_ANCHORS",
            "PROVISIONAL_PROFILE_MATCH_ONLY"
          ]
        },
        "capture_session_id": {
          "type": "string",
          "minLength": 1
        },
        "frame_id": {
          "type": "integer",
          "minimum": 1
        },
        "epoch": {
          "type": "integer",
          "minimum": 1
        },
        "image_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "receipt_uptime_ms": {
          "type": "integer",
          "minimum": 1
        },
        "roi_coordinate_space": {
          "const": "ANALYSIS_PIXELS_TOP_LEFT"
        },
        "scope": {
          "const": "HISTORICAL_FRAME_LAYOUT_CANDIDATES_ONLY"
        },
        "calibration_certified": {
          "const": false
        },
        "owner_certified": {
          "const": false
        },
        "current_state_eligible": {
          "const": false
        },
        "battle_advice_authorized": {
          "const": false
        },
        "anchors": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "object"
          }
        },
        "associations": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "$ref": "#/$defs/layoutAssociation"
          }
        },
        "conflict_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 12
        }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "screen_read_engine_version": {
            "enum": [
              "r552.snapshot.v1",
              "r553.snapshot.v1"
            ]
          }
        },
        "required": [
          "screen_read_engine_version"
        ]
      },
      "then": {
        "required": [
          "conflicts"
        ],
        "properties": {
          "knowledge_state": {
            "enum": [
              "UNKNOWN",
              "CONFLICT"
            ]
          },
          "candidates": {
            "items": {
              "$ref": "#/$defs/structuredCandidate"
            }
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "screen_read_engine_version"
        ],
        "properties": {
          "screen_read_engine_version": {
            "const": "r553.snapshot.v1"
          }
        }
      },
      "then": {
        "required": [
          "layout_candidates"
        ],
        "properties": {
          "candidates": {
            "items": {
              "required": [
                "ocr_rank"
              ]
            }
          }
        }
      }
    }
  ]
}
